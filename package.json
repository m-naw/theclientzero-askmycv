{
  "name": "askmycv",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, BYOK Cloudflare Worker that lets visitors chat with your CV.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "dev": "wrangler dev"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "ws": "^8.20.1",
      "esbuild": "^0.25.0",
      "devalue": "^5.6.4",
      "wrangler": "^4.93.0"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@types/bcryptjs": "^2.4.6",
    "@cloudflare/workers-types": "^4.20260519.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.93.0"
  }
}
